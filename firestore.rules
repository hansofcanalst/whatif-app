rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // `quotaExempt` is a server-only allow-list flag (reviewer cap
      // exemption). A client must never grant itself the exemption, so it
      // may only CREATE its doc without the field (or explicitly false).
      // The Admin SDK / console — which bypass these rules — are the only
      // writers that set it true.
      allow create: if request.auth != null && request.auth.uid == uid
        && (!('quotaExempt' in request.resource.data) || request.resource.data.quotaExempt == false);
      // `subscriptionStatus`, `freeGenerationsUsed`, and `quotaExempt` are
      // server-controlled (the RevenueCat webhook and the generate Cloud
      // Function write them via the Admin SDK, which bypasses these rules).
      // Clients may not MODIFY them — that would let a user grant themselves
      // Pro, reset their free-generation count, or exempt themselves from
      // the cap.
      //
      // Carve-out: a client MAY INITIALIZE either field when it is ABSENT,
      // and only to its safe default (freeGenerationsUsed -> 0,
      // subscriptionStatus -> 'free'). This lets ensureUserDoc() backfill a
      // doc that another writer (push-token registration, the RC webhook)
      // created via a merge write before the base fields were set — the
      // "NaN/3 FREE" / permanent soft-lock bug. Initializing to the default
      // is not a cheat (0 used / free is the honest starting state), and
      // once the field is present the carve-out no longer applies, so a
      // usage reset (5 -> 0) or a self-granted upgrade stays denied.
      allow update: if request.auth != null && request.auth.uid == uid
        && (
          !('subscriptionStatus' in request.resource.data.diff(resource.data).affectedKeys())
          || (!('subscriptionStatus' in resource.data) && request.resource.data.subscriptionStatus == 'free')
        )
        && (
          !('freeGenerationsUsed' in request.resource.data.diff(resource.data).affectedKeys())
          || (!('freeGenerationsUsed' in resource.data) && request.resource.data.freeGenerationsUsed == 0)
        )
        // No client may add or change `quotaExempt`. Unlike the two fields
        // above there is no init carve-out — the safe default is simply the
        // field's absence, so a client never needs to write it.
        && !('quotaExempt' in request.resource.data.diff(resource.data).affectedKeys());
      // Owners can delete their own account (the Profile screen's
      // "Delete Account" flow). Required for App Store policy and
      // GDPR/CCPA right-to-erasure compliance.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /generations/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Owners can delete their own entries (the Gallery's long-press flow).
      // Create + update remain server-only — the Cloud Function writes
      // generations via Admin SDK which bypasses these rules.
      // Note: deleting the Firestore doc leaves the Storage objects
      // (original + result images) orphaned. A periodic Cloud Function
      // sweep is the right cleanup mechanism; not blocking on it for
      // MVP because the storage cost is negligible at current scale.
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /rateLimits/{uid} {
      allow read, write: if false;
    }
    // Per-variant telemetry. Written exclusively server-side by the
    // generate Cloud Function (Admin SDK bypasses these rules). No
    // client access — inspect via the Firebase console or a server-side
    // admin-tool query. Schema:
    //   generationId, userId, categoryId, subcategoryId,
    //   status ('complete' | 'failed'), errorMessage?, durationMs,
    //   promptSource, attempts, modelId, source, timestamp
    match /logs/{id} {
      allow read, write: if false;
    }
    // Moderation audit log. Written server-side by the generate Cloud
    // Function (Admin SDK bypasses rules). No client read or write —
    // this is an audit trail for takedown / abuse review and must not
    // be tamperable from the client. The local-dev client write in
    // lib/gemini.ts (persistLocalGeneration) silently fails here on
    // purpose; production audit goes through the Cloud Function path.
    match /moderation_log/{id} {
      allow read, write: if false;
    }
    // Remote-updatable "Trending This Week" carousel docs. Authored
    // exclusively by the admin (scripts/add-trend.js or the Firebase
    // console — both go through Admin SDK / console which bypasses
    // these rules). The client reads them to populate the home-screen
    // carousel; the generate endpoint re-fetches them server-side to
    // resolve the canonical promptTemplate.
    //
    // Read is limited to active==true docs so a paginating client
    // can't see drafts or expired/disabled trends. Date-window
    // filtering (startDate/endDate) is enforced client-side in
    // isTrendLive AND server-side in isServerTrendLive — Firestore
    // rules can't model the optional-bounded-window predicate
    // cleanly in a single rule, but the duplicate check covers any
    // stale-cache window.
    //
    // No client writes — only `scripts/add-trend.js` (Admin SDK) or
    // the Firebase console can publish, edit, or retire a trend.
    match /trending/{trendId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }
  }
}
